# 사이트 URL — Vercel 배포 후 실제 주소로 변경 (예: https://seowoo-blog.vercel.app)
NEXT_PUBLIC_SITE_URL=https://seowoo-blog.vercel.app

# OpenAI API 키 (콘텐츠 자동 생성용)
# https://platform.openai.com/api-keys 에서 발급
OPENAI_API_KEY=sk-...

# Google Indexing API — 구글 자동 색인용 (선택, 나중에 설정 가능)
# Google Cloud Console → 서비스 계정 생성 → JSON 키 발급
# JSON 내용 전체를 한 줄로 붙여넣기
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
GOOGLE_SITE_URL=https://seowoo-blog.vercel.app
